# Copy to .env and fill in real values. Never commit .env.
# Every value below is validated at startup; the process exits if one is missing.

# --- Database (Supabase Postgres, Supavisor transaction pooler) ---
# Dashboard > Connect > Transaction pooler. Port 6543 does not support prepared
# statements; the client sets prepare:false. The direct db.<ref> host is IPv6-only.
DATABASE_URL=postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_DB_PASSWORD@aws-0-REPLACE_REGION.pooler.supabase.com:6543/postgres

# --- Supabase project keys (dashboard > Project Settings > API) ---
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=REPLACE_SECRET_KEY
# Public signing keys. apps/server/src/middleware/auth.ts verifies access tokens
# locally against this JWKS, so no Auth API call is made per request.
SUPABASE_JWKS_URL=https://REPLACE_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# --- AI ---
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash
DAILY_TOKEN_BUDGET=1000000

# --- HTTP API ---
NODE_ENV=development
LOG_LEVEL=info
API_PORT=8000
API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Worker ---
WORKER_CONCURRENCY=2
WORKER_POLL_MS=2000
TASK_LEASE_SECONDS=180
TASK_MAX_ATTEMPTS=3

# --- Browser ---
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
