# Copy to .env and fill in real values. Never commit .env.
# Every value below is validated at startup; the process exits if one is missing.

# --- Database (Supabase Postgres, direct connection string) ---
DATABASE_URL=postgres://postgres:password@db.example.supabase.co:5432/postgres

# --- Supabase (project settings > API) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash
DAILY_TOKEN_BUDGET=1000000

# --- HTTP API ---
NODE_ENV=development
LOG_LEVEL=info
API_PORT=8000
API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Worker ---
WORKER_CONCURRENCY=2
WORKER_POLL_MS=2000
TASK_LEASE_SECONDS=180
TASK_MAX_ATTEMPTS=3

# --- Browser ---
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# --- Web app (apps/web reads these two as PUBLIC_*) ---
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
