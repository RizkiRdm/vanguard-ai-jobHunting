{
  "name": "vanguard",
  "private": true,
  "version": "2.0.0",
  "description": "Vanguard AI job hunting system - TypeScript rewrite",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' --if-present dev",
    "dev:all": "bash scripts/dev.sh",
    "dev:server": "bun --filter @vanguard/server dev",
    "dev:web": "bun --filter @vanguard/web dev",
    "worker": "bun --filter @vanguard/server worker",
    "build": "bun --filter @vanguard/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p apps/server && bun --filter @vanguard/web check",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build",
    "doctor": "node scripts/doctor.mjs",
    "db:migrate": "tsx apps/server/src/scripts/migrate.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "prettier-plugin-svelte": "^4.1.1",
    "supabase": "^3.0.0",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "trustedDependencies": [
    "esbuild",
    "protobufjs"
  ],
  "dependencies": {
    "@supabase/server": "^1.9.2"
  }
}
